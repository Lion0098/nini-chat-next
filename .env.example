# Copy this file to .env and replace every placeholder before starting.
# Use a long random alphanumeric database password to avoid URL-encoding issues.
POSTGRES_DB=nini_chat
POSTGRES_USER=nini_chat
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_password

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters_long
# Public HTTPS origin of the app (no trailing slash), e.g. https://chat.example.com
BETTER_AUTH_URL=https://chat.example.com

# Optional: configure only if you intentionally want the existing OAuth providers.
# Production no longer falls back to shared preview credentials.
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=


# Authentication is required in production; never deploy with this set to false.
VITE_AUTH_ENABLED=true

# Optional email verification delivery (Resend-compatible HTTP API).
# Leave unset to keep verification optional; manual verification will report delivery unavailable.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Nini Chat

# SMS.ir Verify endpoint. Start with a Sandbox API key; no key is committed here.
SMS_IR_MODE=sandbox
SMS_IR_API_KEY_SANDBOX=
SMS_IR_API_KEY_PRODUCTION=
SMS_IR_PRODUCTION_APPROVED=false
SMS_IR_TEMPLATE_ID=
SMS_IR_TEMPLATE_PARAMETER_NAME=Code
